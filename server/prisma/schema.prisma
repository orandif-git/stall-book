generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StallStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMode {
  CASH
  CHEQUE
  UPI
  BANK_TRANSFER
  OTHER
}

enum AdminRole {
  SUPER_ADMIN
  STAFF
}

enum BookedByOrg {
  MEC
  CHAMBER_OF_COMMERCE
}

enum DecorKind {
  WALL
  AISLE
  STAIRS
  LABEL
  ARROW
}

enum HoldSource {
  ADMIN
  PUBLIC_REQUEST
}

enum MessagePurpose {
  OTP
}

model AdminUser {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  role         AdminRole   @default(STAFF)
  bookedByOrg  BookedByOrg @default(MEC)
  createdAt    DateTime    @default(now())

  bookings     Booking[]
  activityLogs ActivityLog[]
}

model Event {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  venue         String
  startDate     DateTime
  endDate       DateTime
  layoutImageUrl String?
  // Logical size of the floor-plan canvas that stall posX/posY/width/height are
  // expressed in (traced from the reference drawing) — not a pixel/DOM size.
  canvasWidth   Float    @default(1500)
  canvasHeight  Float    @default(850)
  createdAt     DateTime @default(now())

  categories     Category[]
  stalls         Stall[]
  bookings       Booking[]
  holds          Hold[]
  decor          FloorPlanDecor[]
  requestCounter EventRequestCounter?
}

// One row per event, atomically incremented to assign each public booking request a
// sequential, human-readable reference (e.g. "MC-26-00001") — see Hold.reference and
// server/src/routes/public.ts's submit-request handler. A Prisma `increment` update compiles
// to an atomic SQL UPDATE, so concurrent submissions never get the same number.
model EventRequestCounter {
  eventId String @id
  count   Int    @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Category {
  id        String   @id @default(cuid())
  eventId   String
  code      String   // e.g. "A", "B", "S1"
  label     String   // e.g. "3 M x 3 M (AA1 to AA2)"
  size      String?  // e.g. "3 M x 3 M"
  price     Decimal  @db.Decimal(10, 2)
  colorHex  String?  // for map rendering, mirrors legend swatches
  createdAt DateTime @default(now())

  event    Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  stalls   Stall[]
  activity ActivityLog[]

  @@unique([eventId, code])
}

model Stall {
  id         String      @id @default(cuid())
  eventId    String
  categoryId String
  code       String      // e.g. "B23"
  zone       String?     // e.g. "S6" block / hall reference
  gridRow    Int
  gridCol    Int
  rowSpan    Int         @default(1)
  colSpan    Int         @default(1)
  status     StallStatus @default(AVAILABLE)
  // Floor-plan geometry, in the owning Event's canvasWidth/canvasHeight unit space.
  // Nullable — a stall without geometry simply doesn't render on the plan yet.
  // posX/posY/width/height are always kept as the bounding box — for "rect" stalls that's
  // the shape itself; for "poly" stalls it's computed from `points` and used as a hit-testing
  // shortcut, label placement anchor, and scroll-to-stall target, while the actual visible
  // shape is drawn from `points`.
  posX       Float?
  posY       Float?
  width      Float?
  height     Float?
  rotation   Float       @default(0)
  shape      String      @default("rect") // "rect" | "poly"
  points     Float[]     @default([]) // [x1,y1,x2,y2,...] when shape = "poly"
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  event        Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category     Category       @relation(fields: [categoryId], references: [id])
  bookingLinks BookingStall[]
  holdLinks    HoldStall[]

  @@unique([eventId, code])
}

// Non-interactive floor-plan furniture — walls, aisle dashes, stair blocks, entry/exit
// arrows, and text labels (PORTICO, MURAL, etc). Purely decorative: nothing else in the
// app reads or writes this table, it only feeds the interactive floor-plan renderer.
model FloorPlanDecor {
  id      String    @id @default(cuid())
  eventId String
  kind    DecorKind
  posX    Float?
  posY    Float?
  width   Float?
  height  Float?
  text    String?
  points  Float[]   @default([]) // polyline points (x1,y1,x2,y2,...) for aisle dashes etc.

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Booking {
  id            String        @id @default(cuid())
  eventId       String
  exhibitorName String
  company       String?
  phone         String
  email         String?
  gst           String?
  address       String?
  city          String?
  productService String?
  // Human-readable reference, e.g. "MC-26-00001" — reused from Hold.reference when converting
  // a public request, otherwise freshly assigned (see server/src/lib/reference.ts). Null for
  // bookings created before this field existed.
  reference     String?       @unique
  totalAmount   Decimal       @db.Decimal(10, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(UNPAID)
  bookedByOrg   BookedByOrg   @default(MEC)
  notes         String?
  bookedById    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  event    Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookedBy AdminUser?     @relation(fields: [bookedById], references: [id])
  stalls   BookingStall[]
  payments Payment[]
  activity ActivityLog[]
}

model BookingStall {
  id        String @id @default(cuid())
  bookingId String
  stallId   String

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  stall   Stall   @relation(fields: [stallId], references: [id])

  @@unique([stallId]) // a stall can only be part of one active booking
}

// A stall "block": reserved off the market, optionally for a named exhibitor, optionally with
// an auto-release date. Distinct from Booking — no payment involved, and it can be converted
// into a real Booking later ("confirm as booking") using the same details.
model Hold {
  id            String      @id @default(cuid())
  eventId       String
  exhibitorName String?
  company       String?
  phone         String?
  email         String?
  address       String?
  city          String?
  // What the exhibitor plans to showcase/sell — shown to the admin alongside a public request
  // so they have real context for the approve/reject decision, not just stall codes and price.
  productService String?
  notes         String?
  bookedByOrg   BookedByOrg @default(MEC)
  source        HoldSource  @default(ADMIN)
  otpVerifiedAt DateTime?
  // Human-readable reference for a public request, e.g. "MC-26-00001" — assigned once, at
  // submission (see EventRequestCounter), never reformatted later even if the event changes.
  reference     String?
  releaseAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  event    Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  stalls   HoldStall[]
  activity ActivityLog[]
}

model HoldStall {
  id      String @id @default(cuid())
  holdId  String
  stallId String

  hold  Hold  @relation(fields: [holdId], references: [id], onDelete: Cascade)
  stall Stall @relation(fields: [stallId], references: [id])

  @@unique([stallId])
}

// A short, compact activity trail shown inline in the booking/block drawer — not a
// separate audit page. performedByName is a snapshot taken at write time so the
// entry still reads correctly even after that admin's account is later deleted.
model ActivityLog {
  id              String   @id @default(cuid())
  eventId         String
  action          String // e.g. "CREATED" | "EDITED" | "PAYMENT_ADDED"
  description     String // short, human-readable one-liner
  performedById   String?
  performedByName String
  createdAt       DateTime @default(now())

  bookingId  String?
  holdId     String?
  categoryId String?

  booking     Booking?   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  hold        Hold?      @relation(fields: [holdId], references: [id], onDelete: Cascade)
  category    Category?  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  performedBy AdminUser? @relation(fields: [performedById], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([holdId])
  @@index([categoryId])
}

model Payment {
  id        String      @id @default(cuid())
  bookingId String
  amount    Decimal     @db.Decimal(10, 2)
  mode      PaymentMode
  reference String?     // cheque no. / UPI ref / transaction id — n/a for cash
  paidAt    DateTime    @default(now())
  notes     String?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// A short-lived WhatsApp OTP challenge for the public booking portal — one row per phone
// number, overwritten on each new send. No relation to any other model; purely a
// verify-then-discard credential, checked by server/src/lib/otp.ts.
model OtpVerification {
  id            String    @id @default(cuid())
  phone         String    @unique
  codeHash      String
  attempts      Int       @default(0)
  maxAttempts   Int       @default(5)
  expiresAt     DateTime
  cooldownUntil DateTime
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
}

// Singleton — one row holds the whole app's WhatsApp BSP connection + OTP tunables. No
// multi-tenant split (unlike the BNI project this was modeled on): this app has one WhatsApp
// Business number for the whole deployment. bspApiKey is never sent back to the browser once
// set (see server/src/routes/waSettings.ts) — only whether it's set.
model WhatsAppSettings {
  id                       String   @id @default(cuid())
  bspBaseUrl               String?
  bspApiKey                String?
  bspFromPhoneNumberId     String?
  otpLength                Int      @default(6)
  otpTtlSeconds            Int      @default(300)
  otpMaxAttempts           Int      @default(5)
  otpResendCooldownSeconds Int      @default(30)
  // Cloudflare Turnstile bot-check gate in front of /api/public/otp/request — siteKey is public
  // (served to the anonymous booking page), turnstileSecretKey never leaves the server (same
  // never-returned-once-set convention as bspApiKey). turnstileEnabled lets an admin switch the
  // gate off without losing the saved keys, e.g. if it's ever misbehaving in prod.
  turnstileSiteKey         String?
  turnstileSecretKey       String?
  turnstileEnabled         Boolean  @default(true)
  updatedAt                DateTime @updatedAt
}

// One row per message purpose (just OTP today) — fieldBindings maps this app's own data
// (e.g. "otp.code") onto the BSP payload keys the approved WhatsApp template expects (e.g.
// "field_1"), same {field, source} shape as the BNI project's template field bindings.
model MessageTemplate {
  id               String         @id @default(cuid())
  purpose          MessagePurpose @unique
  templateName     String
  templateLanguage String         @default("en")
  fieldBindings    Json           @default("[]")
  updatedAt        DateTime       @updatedAt
}
